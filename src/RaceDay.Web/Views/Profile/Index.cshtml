@model ProfileForm
<h1>My profile</h1><form method="post" enctype="multipart/form-data" class="form-card"><label>Full name</label><input asp-for="FullName" class="form-control mb-3"><label>Phone</label><input asp-for="Phone" class="form-control mb-3"><label>Profile picture</label><input asp-for="Picture" type="file" accept="image/*" class="form-control mb-3"><button class="btn btn-warning">Save profile</button></form>
