<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" href="/">RACEDAY<span class="text-warning">.</span></a><div class="navbar-nav ms-auto align-items-center">@if(Context.Session.GetString("User") is not null){var u=System.Text.Json.JsonSerializer.Deserialize<UserModel>(Context.Session.GetString("User")!);<span class="nav-link">Hi, @u?.FullName</span><a class="nav-link" href="/Profile">Profile</a>@if(u?.Role==UserRole.Organiser){<a class="nav-link" href="/Organiser">Organiser hub</a>}else{<a class="nav-link" href="/Participant/History">My races</a>}<form method="post" action="/Account/Logout"><button class="btn btn-sm btn-outline-warning ms-2">Sign out</button></form>}else{<a class="nav-link" href="/Account/Login">Sign in</a><a class="btn btn-warning btn-sm ms-2" href="/Account/Register">Join RaceDay</a>}</div></div></nav><main class="container py-4">@RenderBody()</main><footer class="border-top mt-5 py-4 text-center text-muted">RaceDay — run your next personal best.</footer></body></html>
