@model List<EventModel>
<div class="hero p-5 rounded-4 mb-5"><p class="eyebrow">COMMUNITY. MOTION. MOMENTUM.</p><h1>Find your next finish line.</h1><p class="lead">Discover upcoming runs, walks, and cycles across the city.</p><a class="btn btn-warning" href="#events">Explore events</a></div><div id="events" class="d-flex justify-content-between align-items-center mb-3"><h2>Upcoming events</h2><span class="text-muted">@Model.Count races listed</span></div><div class="row g-4">@foreach(var e in Model){<div class="col-md-4"><div class="card h-100 shadow-sm border-0"><div class="card-body"><span class="badge text-bg-dark mb-3">@e.EventType · @e.DistanceKm km</span><h3 class="h5">@e.Name</h3><p class="text-muted">@e.Description</p><p class="small mb-1">📍 @e.Location</p><p class="small">📅 @e.EventDate.ToString("ddd, dd MMM yyyy")</p><a class="btn btn-outline-dark" href="/Home/Event/@e.Id">View details</a></div></div></div>}</div>
