@model EventModel
<h1>@Model.Name</h1><p class="lead">@Model.Description</p><div class="row"><div class="col-md-7"><dl class="row"><dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.EventDate.ToString("dd MMMM yyyy HH:mm")</dd><dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd><dt class="col-sm-3">Distance</dt><dd class="col-sm-9">@Model.DistanceKm km @Model.EventType</dd></dl></div><div class="col-md-5"><div class="card bg-light border-0"><div class="card-body"><h3 class="h5">Ready to enter?</h3><p>Sign in as a Participant to select a category and enrol immediately.</p><a class="btn btn-dark" href="/Participant/Event/@Model.Id">See categories</a></div></div></div></div>
