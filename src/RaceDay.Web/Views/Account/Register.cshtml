@model RegisterModel
<h1>Join the starting line.</h1><form method="post" class="form-card"><div asp-validation-summary="All" class="text-danger"></div><label>Full name</label><input asp-for="FullName" class="form-control mb-3"><label>Email</label><input asp-for="Email" class="form-control mb-3"><label>Password</label><input asp-for="Password" type="password" class="form-control mb-3"><label>Role</label><select asp-for="Role" class="form-select mb-3"><option value="Participant">Participant</option><option value="Organiser">Organiser</option></select><label>Phone</label><input asp-for="Phone" class="form-control mb-3"><button class="btn btn-warning">Create account</button></form>
