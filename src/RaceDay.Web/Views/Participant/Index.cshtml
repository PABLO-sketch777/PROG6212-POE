@model List<EventModel>
<p class="eyebrow">PARTICIPANT HOME</p><h1>Choose your next challenge.</h1><div class="row g-4 mt-2">@foreach(var e in Model){<div class="col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-dark">@e.EventType</span><h2 class="h5 mt-2">@e.Name</h2><p class="text-muted">@e.EventDate.ToString("dd MMM yyyy") · @e.DistanceKm km</p><a class="btn btn-warning" href="/Participant/Event/@e.Id">View & enrol</a></div></div></div>}</div>
