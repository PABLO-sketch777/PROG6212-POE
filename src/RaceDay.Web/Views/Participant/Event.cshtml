@model EventModel
<h1>@Model.Name</h1><p>@Model.Description</p><h2 class="h4 mt-4">Select your category</h2><div class="row g-3">@foreach(var c in (List<CategoryModel>)ViewBag.Categories){<div class="col-md-4"><div class="card border-0 bg-light"><div class="card-body"><h3 class="h5">@c.Name</h3><p>@c.DistanceKm km · ages @c.MinimumAge–@c.MaximumAge</p><form method="post" action="/Participant/Enrol"><input type="hidden" name="eventId" value="@Model.Id"><input type="hidden" name="categoryId" value="@c.Id"><button class="btn btn-dark">Enrol now</button></form></div></div></div>}</div>
