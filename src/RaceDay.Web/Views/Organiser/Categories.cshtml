@model List<CategoryModel>
<h1>Categories</h1><p class="text-muted">@ViewBag.Event?.Name</p><div class="row"><div class="col-md-7"><table class="table"><thead><tr><th>Name</th><th>Age</th><th>Distance</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.MinimumAge–@c.MaximumAge</td><td>@c.DistanceKm km</td></tr>}</tbody></table></div><div class="col-md-5"><form method="post" action="/Organiser/AddCategory/@ViewBag.Event?.Id" class="form-card"><h2 class="h5">Add category</h2><input name="Name" placeholder="Senior 10km" class="form-control mb-2"><input name="MinimumAge" placeholder="Minimum age" class="form-control mb-2"><input name="MaximumAge" placeholder="Maximum age" class="form-control mb-2"><input name="DistanceKm" placeholder="Distance km" class="form-control mb-2"><button class="btn btn-dark">Add category</button></form></div></div>
