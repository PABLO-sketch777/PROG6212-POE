@model List<EventModel>
<div class="d-flex justify-content-between align-items-center"><div><p class="eyebrow">ORGANISER HUB</p><h1>Your race calendar</h1><p class="text-muted">@Model.Count events · upcoming dates and enrolment management</p></div><a class="btn btn-warning" href="/Organiser/Create">Create event</a></div><div class="row g-4 mt-2">@foreach(var e in Model){<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-success">Upcoming</span><h2 class="h4 mt-2">@e.Name</h2><p>@e.EventDate.ToString("dd MMM yyyy") · @e.Location</p><a class="btn btn-sm btn-dark" href="/Organiser/Edit/@e.Id">Edit</a><a class="btn btn-sm btn-outline-dark ms-2" href="/Organiser/Categories/@e.Id">Categories</a><a class="btn btn-sm btn-outline-dark ms-2" href="/Organiser/Enrolments/@e.Id">Enrolments & results</a><form class="d-inline" method="post" action="/Organiser/Delete/@e.Id"><button class="btn btn-sm btn-outline-danger ms-2">Delete</button></form></div></div></div>}</div>
