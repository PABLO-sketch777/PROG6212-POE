@model EventForm
<h1>Create an event</h1><form method="post" enctype="multipart/form-data" class="form-card"><label>Name</label><input asp-for="Name" class="form-control mb-3"><label>Description</label><textarea asp-for="Description" class="form-control mb-3"></textarea><label>Date</label><input asp-for="EventDate" class="form-control mb-3"><label>Location</label><input asp-for="Location" class="form-control mb-3"><label>Distance (km)</label><input asp-for="DistanceKm" class="form-control mb-3"><label>Event type</label><select asp-for="EventType" class="form-select mb-3"><option>Run</option><option>Walk</option><option>Cycle</option></select><label>Banner image</label><input asp-for="Banner" type="file" accept="image/*" class="form-control mb-3"><button class="btn btn-warning">Publish event</button></form>
