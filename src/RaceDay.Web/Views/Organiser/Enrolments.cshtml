@model List<EnrollmentModel>
<h1>Enrolments & results</h1><table class="table align-middle"><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Result</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td><span class="badge status-confirmed">Confirmed</span></td><td>@if(e.FinishTime is null){<form method="post" action="/Organiser/Result/@e.Id" class="d-flex gap-1"><input type="hidden" name="eventId" value="@e.EventId"><input name="FinishTime" placeholder="01:00:00" class="form-control form-control-sm"><input name="FinishingPosition" placeholder="Pos." class="form-control form-control-sm"><button class="btn btn-sm btn-dark">Publish</button></form>}else{<span>@e.FinishTime · position @e.FinishingPosition</span>}</td></tr>}</tbody></table>
